#!/bin/sh
# RÍO staged manifest guard: read-only, fail closed, no automatic refresh.
set -eu
root=$(git rev-parse --show-toplevel) || exit 2
if ! command -v python3 >/dev/null 2>&1; then
    echo "RIO_MANIFEST_HOOK_BLOCKED: python3 missing" >&2
    exit 2
fi
exec python3 "$root/scripts/prepare_staged_manifest.py"
